{
  "name": "wireup",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node scripts/python.mjs -m backend.run",
    "test": "playwright test",
    "test:api": "node scripts/python.mjs -m pytest backend/tests -q",
    "build": "tsc -b && vite build",
    "lint": "oxlint src tests scripts vite.config.ts playwright.config.ts",
    "preview": "vite preview"
  },
