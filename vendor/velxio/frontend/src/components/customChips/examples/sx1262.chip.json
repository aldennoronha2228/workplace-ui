{
  "schema": "velxio-chip/v1",
  "name": "SX1262 LoRa",
  "author": "Martin Thuku",
  "license": "MIT",
  "description": "Semtech SX1262 LoRa transceiver model. SPI slave on NSS/SCK/MOSI/MISO with BUSY, DIO1 and RESET, plus a synthetic ANT pin that carries a Manchester-coded frame to every other SX1262 wired to the same net.",
  "pins": [
    "SCK",
    "MOSI",
    "MISO",
    "NSS",
    "BUSY",
    "DIO1",
    "RESET",
    "ANT",
    "VCC",
    "GND"
  ],
  "attributes": [
    {
      "name": "rssi_dbm",
      "label": "RSSI (dBm)",
      "type": "int",
      "default": -80,
      "min": -157,
      "max": -20
    },
    {
      "name": "drop_percent",
      "label": "Frame drop (%)",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 100
    },
    {
      "name": "bit_period_us",
      "label": "Air bit period (us)",
      "type": "int",
      "default": 20,
      "min": 4,
      "max": 200000
    },
    {
      "name": "label",
      "label": "Label",
      "type": "string",
      "default": "sx1262"
    }
  ]
}
