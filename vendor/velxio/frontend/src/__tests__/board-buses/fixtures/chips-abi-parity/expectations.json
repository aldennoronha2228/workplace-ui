          "op": "ce",
          "mosi": [
            6
          ],
          "miso": [
            161
          ],
          "hold": false,
          "why": "XC keeps the select down: the second transfer continues the same frame"
        },
        {
          "op": "trace",
          "expect": [
            "pin CS=0",
            "pin CS=1",
            "spi_done h=0 n=2 buf=own",
            "spi_rx 0=05",
            "spi_rx 1=06"
          ],
          "why": "CS rising ends the frame at two bytes, from the chip's own vx_spi_stop"
        }
      ]
    },
